# Write values WITHOUT quotes (Docker's --env-file keeps quotes as part of the value).

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Seed (dev/test only) ---
# Password for every seeded user (min 8 characters). Not used by the running app.
SEED_PASSWORD=

# --- Server ---
PORT=4000

# Production only: browser origins allowed to call the API, comma separated, no trailing slash
# (e.g. https://my-frontend.onrender.com). Empty = no cross-origin access. Dev and tests ignore it.
CORS_ORIGIN=

# --- Receipts ---
# Folder where uploaded receipt files are stored (relative to backend/ or absolute). Default: uploads
UPLOAD_DIR=uploads
# Where receipt files are kept: local (the UPLOAD_DIR folder) or s3 (an S3-compatible bucket, e.g. Neon Object Storage). Default: local
STORAGE_DRIVER=local
# Only needed when STORAGE_DRIVER=s3 (the names Neon gives; values come from Neon > Settings > Credentials)
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent  (default: info)
LOG_LEVEL=info

# --- Database (Neon Postgres) ---
# Direct connection (host WITHOUT "-pooler"). Used by the Prisma CLI for migrations.
DATABASE_URL=
# Pooled connection (host WITH "-pooler"). Used by the running app via the pg adapter.
DATABASE_URL_POOLED=