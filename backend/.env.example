# Write values WITHOUT quotes (Docker's --env-file keeps quotes as part of the value).

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Seed (dev/test only) ---
# Password for every seeded user (min 8 characters). Not used by the running app.
SEED_PASSWORD=

# --- Server ---
PORT=4000

# Reverse proxies in front of the API: 0 locally (no proxy), 1 on Render. Used to read the real client IP
# (rate limiting, logs). Never set it higher than the real number of proxies: that lets clients fake their IP.
TRUST_PROXY_HOPS=0

# Production only: browser origins allowed to call the API, comma separated, no trailing slash
# (e.g. https://my-frontend.onrender.com). Empty = no cross-origin access. Dev and tests ignore it.
CORS_ORIGIN=

# --- Receipts ---
# Required. A private S3-compatible bucket (Neon Object Storage); use a separate bucket and credential per
# environment (dev, test, production). Names as Neon gives them; values from Neon > Settings > Credentials.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent  (default: info)
LOG_LEVEL=info

# --- Database (Neon Postgres) ---
# Direct connection (host WITHOUT "-pooler"). Used by the Prisma CLI for migrations.
DATABASE_URL=
# Pooled connection (host WITH "-pooler"). Used by the running app via the pg adapter.
DATABASE_URL_POOLED=